legacy-peer-deps=true
# Pacotes da org (@elizfab/*) vêm do GitHub Packages: exige NODE_AUTH_TOKEN com read:packages
# (localmente: export NODE_AUTH_TOKEN=$(gh auth token); nos workflows: secrets.GITHUB_TOKEN)
@elizfab:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
